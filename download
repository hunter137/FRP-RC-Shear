    # LLX2026 model, 9-parameter median-normalized identifiable form.
    # DE solution calibrated on the NU database using complete experimental-series grouping.
    #   eps = A*(wc/0.5)^b2 * (1-h^b3)/(1-0.5^b3)
    #          * [dt/(dt + tau*(VtoS/VS_MED)^b5)]^b6 * (1 + b7*exp(-dt/50))
    #          * (1 - b8*ln(t0/7)) * ((1-Va)/(1-VA_MED))^b9
    # The strength term of the code-lineage models was dropped (collinear with w/c and
    # not identifiable); composition is carried by w/c and the aggregate volume fraction.
    THETA = np.array([
        1062.3529,  # theta1  reference-condition shrinkage magnitude
        0.319716,   # theta2  water-to-cement exponent
        1.500000,   # theta3  humidity exponent
        61.51684,   # theta4  characteristic time
        1.349781,   # theta5  volume-to-surface exponent
        0.845264,   # theta6  time-development exponent
        0.361052,   # theta7  early-age amplitude
        0.115219,   # theta8  curing-age coefficient
        0.389485,   # theta9  aggregate-restraint exponent
    ])
    VS_MED = 22.7273       # reference volume-to-surface ratio (mm)
    VA_MED = 0.7015        # reference aggregate-volume proxy
    RHO_AGG = 2650.0       # nominal aggregate particle density (kg/m3)

    # Additive half-widths of the cross-fitted empirical prediction intervals, in
    # microstrain. Values are the fold-weighted widths reported in Fig. 12 divided by two.
    # The final band is retained separately because long-term coverage is lower and should
    # not be concealed by interpolation with the densely represented ages.
    PI_HALF_WIDTHS = [
        (0.0, 7.0, 61.1152, 72.3735),
        (7.0, 28.0, 88.2015, 112.9973),
        (28.0, 180.0, 108.6639, 144.0709),
        (180.0, 1000.0, 102.5550, 117.9668),
        (1000.0, float("inf"), 89.8207, 109.9725),
    ]
    
